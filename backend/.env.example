# ==============================================================================
# GDG RBU EventHub - Backend Environment Variables Configuration
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (MongoDB)
# In local development, if no MongoDB instance is running, an in-memory
# MongoDB automatically boots up as a fallback.
MONGODB_URI=mongodb://localhost:27017/gdg-eventhub

# Optional Redis Cache (In-memory fallback runs automatically if Redis is unavailable)
REDIS_URI=redis://localhost:6379

# ==============================================================================
# Authentication & Cryptographic Secrets (DO NOT COMMIT REAL VALUES TO GIT)
# Generate 64-character random hex keys for production:
# PowerShell: -join ((1..64) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
# ==============================================================================
JWT_ACCESS_SECRET=replace_with_a_secure_random_access_secret_key_at_least_32_chars
JWT_SECRET=replace_with_a_secure_random_access_secret_key_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_secure_random_refresh_secret_key_at_least_32_chars
OTP_HASH_SECRET=replace_with_a_secure_random_otp_hmac_secret_key_at_least_32_chars
JWT_ACCESS_EXPIRE=15m

# ==============================================================================
# Administrator Authorization Allowlist
# Comma-separated list of verified administrator email addresses.
# Case-insensitive. Entering an email without OTP ownership verification NEVER grants access.
# If empty or not configured, administrative access fails closed (403 Forbidden).
# ==============================================================================
ADMIN_EMAILS=admin@gdgrbu.app,your_real_admin_email@example.com

# ==============================================================================
# Email Delivery Provider: Resend (Default & Recommended Provider)
# Sign up at https://resend.com, generate an API key, and configure:
# ==============================================================================
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM="GDG RBU EventHub" <onboarding@resend.dev>

# ==============================================================================
# Alternative: SMTP Provider (e.g., Gmail App Password or Custom SMTP)
# Used only if RESEND_API_KEY is not provided.
# ==============================================================================
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_gmail_app_password
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
